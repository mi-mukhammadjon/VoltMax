# ─── Asosiy ──────────────────────────────────────────────────
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=voltmax.up.railway.app
CSRF_TRUSTED_ORIGINS=https://voltmax.up.railway.app
CORS_ALLOWED_ORIGINS=
DATABASE_URL=

# ─── Yuklanadigan fayllar: Cloudflare R2 ─────────────────────
# Bularsiz fayllar lokal diskda saqlanadi (ishlab chiqish uchun qulay,
# lekin serverda har deploy'da yo'qoladi).
#
# Qayerdan olinadi:
#   R2_ACCOUNT_ID        Cloudflare panel > R2 > o'ng yuqorida "Account ID"
#   R2_ACCESS_KEY_ID     R2 > Manage API Tokens > Create API Token
#   R2_SECRET_ACCESS_KEY   (token yaratilganda bir marta ko'rsatiladi)
#   R2_BUCKET            bucket nomi, masalan: voltmax-media
#   R2_PUBLIC_URL        bucket > Settings > Public access:
#                        r2.dev subdomenini yoqing yoki o'z domeningizni ulang
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ─── Telegram Gateway (OTP) ──────────────────────────────────
TELEGRAM_GATEWAY_TOKEN=
